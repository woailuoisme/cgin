{{ define "content" }}
<h1 style="box-sizing: border-box; color: #0f172a; font-size: 18px; font-weight: 700; margin-top: 0; text-align: left;">
    Hello{{ if .Name }}, {{ .Name }}{{ else }}!{{ end }}
</h1>
<p style="box-sizing: border-box; color: #475569; font-size: 15px; line-height: 1.6; margin-top: 0; text-align: left;">
    You are receiving this email because you requested a verification code to access your account.
</p>

<div style="box-sizing: border-box; text-align: center; margin: 30px 0;">
    <div style="box-sizing: border-box; background-color: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 8px; display: inline-block; padding: 12px 24px; font-size: 28px; font-weight: 800; letter-spacing: 6px; color: {{ if .ThemePrimary }}{{ .ThemePrimary }}{{ else }}#0f172a{{ end }};">
        {{ .Code }}
    </div>
</div>

<p style="box-sizing: border-box; color: #475569; font-size: 14px; line-height: 1.6; text-align: left;">
    This code is valid for {{ if .ExpiresIn }}{{ .ExpiresIn }} minutes{{ else }}10 minutes{{ end }}. If you did not make this request, you can safely ignore this email.
</p>
{{ end }}
