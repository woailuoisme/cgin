{
    "swagger": "2.0",
    "info": {
        "description": "取值为 \"Bearer \u003caccess_token\u003e\"，含 Bearer 前缀与一个空格（要求具有管理员角色）。",
        "title": "bgin Admin API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/v1",
    "paths": {
        "/admin/auth/change-password": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "校验当前管理员口令后写入新口令。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理员认证"
                ],
                "summary": "管理员修改口令",
                "parameters": [
                    {
                        "description": "当前口令与新口令",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/adminauth.ChangePasswordBody"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "修改成功，无响应体"
                    }
                },
                "x-order": 5
            }
        },
        "/admin/auth/get-session": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "根据当前有效的管理员访问令牌，返回当前管理员的档案资料与权限角色。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理员认证"
                ],
                "summary": "获取当前管理员会话",
                "responses": {
                    "200": {
                        "description": "当前管理员会话档案",
                        "schema": {
                            "$ref": "#/definitions/adminauth.GetSessionResource"
                        }
                    }
                },
                "x-order": 2
            }
        },
        "/admin/auth/sign-in/email": {
            "post": {
                "description": "校验管理员邮箱与口令；邮箱不存在、口令错误或角色非系统管理员统一返回凭据错误，防止账号枚举。登录成功后颁发双令牌。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理员认证"
                ],
                "summary": "管理员邮箱密码登录",
                "parameters": [
                    {
                        "description": "管理员登录凭据",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/adminauth.SignInEmailBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "登录成功并颁发管理端双令牌",
                        "schema": {
                            "$ref": "#/definitions/adminauth.SessionResource"
                        }
                    }
                },
                "x-order": 1
            }
        },
        "/admin/auth/sign-out": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "作废当前管理员访问令牌。若同时传入刷新令牌则一并作废，否则续签通道仍然敞开。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理员认证"
                ],
                "summary": "管理员登出",
                "parameters": [
                    {
                        "description": "可选的刷新令牌",
                        "name": "payload",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/adminauth.SignOutBody"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "已登出，无响应体"
                    }
                },
                "x-order": 4
            }
        },
        "/admin/auth/token/refresh": {
            "post": {
                "description": "使用未过期的管理员刷新令牌轮换一对新的双令牌，旧刷新令牌立即作废。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "管理员认证"
                ],
                "summary": "刷新管理员双令牌",
                "parameters": [
                    {
                        "description": "刷新令牌凭据",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/adminauth.RefreshTokenBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "刷新成功并颁发新双令牌",
                        "schema": {
                            "$ref": "#/definitions/adminauth.SessionResource"
                        }
                    }
                },
                "x-order": 3
            }
        },
        "/admin/users": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "根据分页、关键字、状态与角色条件查询系统用户列表。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户管理"
                ],
                "summary": "用户分页列表",
                "parameters": [
                    {
                        "maximum": 1000000,
                        "minimum": 1,
                        "type": "integer",
                        "example": 1,
                        "description": "当前页码 (从 1 开始，默认 1，上限 1000000，与 maxPage 常量保持一致)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "example": 20,
                        "description": "每页条数 (1-100，默认 20)",
                        "name": "pageSize",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "user",
                            "admin"
                        ],
                        "type": "string",
                        "example": "user",
                        "x-enum-varnames": [
                            "RoleUser",
                            "RoleAdmin"
                        ],
                        "description": "按权限角色过滤 (user: 普通用户, admin: 系统管理员)",
                        "name": "role",
                        "in": "query"
                    },
                    {
                        "maxLength": 120,
                        "type": "string",
                        "example": "alex",
                        "description": "关键字搜索 (按邮箱、昵称、用户名模糊检索)",
                        "name": "search",
                        "in": "query"
                    },
                    {
                        "maxLength": 120,
                        "type": "string",
                        "example": "-createdAt",
                        "description": "排序字段 (字段名前加 - 表示倒序，如 -createdAt)",
                        "name": "sort",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "active",
                            "inactive",
                            "pending",
                            "suspended",
                            "banned",
                            "active",
                            "inactive",
                            "pending",
                            "suspended",
                            "banned"
                        ],
                        "type": "string",
                        "example": "active",
                        "x-enum-varnames": [
                            "StatusActive",
                            "StatusInactive",
                            "StatusPending",
                            "StatusSuspended",
                            "StatusBanned"
                        ],
                        "description": "按账号状态过滤 (active: 正常活跃, inactive: 未激活, banned: 已封禁)",
                        "name": "status",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "用户分页列表",
                        "schema": {
                            "$ref": "#/definitions/admin.UserPageResource"
                        }
                    }
                },
                "x-order": 1
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
