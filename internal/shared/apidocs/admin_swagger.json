        "/admin/users/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "根据用户唯一标识查询用户完整档案与管理审计信息。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户管理"
                ],
                "summary": "获取用户详情",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"usr_01J9X4N8Y0ABCD\"",
                        "description": "用户唯一标识",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "用户完整档案",
                        "schema": {
                            "$ref": "#/definitions/admin.UserResource"
                        }
                    }
                },
                "x-order": 2
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "物理删除指定用户及其关联账号数据，并级联清理权限策略。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户管理"
                ],
                "summary": "注销删除用户",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"usr_01J9X4N8Y0ABCD\"",
                        "description": "用户唯一标识",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "删除成功，无响应体"
                    }
                },
                "x-order": 5
            },
            "patch": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "支持局部字段三态更新，可修改昵称、头像、用户名、手机号、角色、状态及封禁属性。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户管理"
                ],
                "summary": "更新用户信息",
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"usr_01J9X4N8Y0ABCD\"",
                        "description": "用户唯一标识",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "局部更新载荷",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/admin.UpdateUserBody"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "更新后的用户对象",
