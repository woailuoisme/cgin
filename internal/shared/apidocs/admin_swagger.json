    "definitions": {
        "admin.CreateUserBody": {
            "type": "object",
            "required": [
                "email",
                "name",
                "password",
                "role"
            ],
            "properties": {
                "email": {
                    "description": "用户电子邮箱",
                    "type": "string",
                    "maxLength": 254,
                    "example": "alex@example.com"
                },
                "emailVerified": {
                    "description": "邮箱是否已完成验证",
                    "type": "boolean",
                    "example": true
                },
                "image": {
                    "description": "用户头像 URL",
                    "type": "string",
                    "maxLength": 2048,
                    "example": "https://example.com/avatar.png"
                },
                "name": {
                    "description": "用户展示昵称",
                    "type": "string",
                    "maxLength": 120,
                    "minLength": 1,
                    "example": "Alex Mercer"
                },
                "password": {
                    "description": "登录口令 (8-128位)",
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 8,
                    "example": "Secret123!"
                },
                "role": {
                    "description": "用户权限角色 (user: 普通用户, admin: 系统管理员)",
                    "enum": [
                        "user",
                        "admin"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/admin.Role"
                        }
                    ],
                    "example": "user"
                },
                "username": {
                    "description": "唯一登录用户名 (3-30位)",
                    "type": "string",
                    "maxLength": 30,
                    "minLength": 3,
                    "example": "alexmercer"
                }
            }
        },
        "admin.Role": {
            "type": "string",
            "enum": [
