{{ define "content" }}
<h1 style="box-sizing: border-box; color: #0f172a; font-size: 18px; font-weight: 700; margin-top: 0; text-align: left;">
    System Notification: {{ .Title }}
</h1>
<p style="box-sizing: border-box; color: #475569; font-size: 15px; line-height: 1.6; margin-top: 0; text-align: left;">
    This is an automated alert generated by your system.
</p>

{{ template "panel" .Panel }}

{{ if .Details }}
<h2 style="box-sizing: border-box; color: #0f172a; font-size: 14px; font-weight: 700; margin-top: 20px; text-align: left;">
    Additional Details
</h2>
<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="box-sizing: border-box; border: 1px solid #e2e8f0; border-radius: 6px; margin: 15px 0; width: 100%;">
    {{ range $key, $value := .Details }}
    <tr>
        <td style="box-sizing: border-box; border-bottom: 1px solid #f1f5f9; padding: 10px 15px; font-size: 13px; font-weight: bold; color: #64748b; width: 30%;">
            {{ $key }}
        </td>
        <td style="box-sizing: border-box; border-bottom: 1px solid #f1f5f9; padding: 10px 15px; font-size: 13px; color: #0f172a; word-break: break-all;">
            {{ $value }}
        </td>
    </tr>
    {{ end }}
</table>
{{ end }}

{{ if .Button }}
    {{ template "button" .Button }}
{{ end }}

<p style="box-sizing: border-box; color: #475569; font-size: 14px; line-height: 1.6; text-align: left;">
    If you did not expect this warning, please contact your system administrator.
</p>
{{ end }}
