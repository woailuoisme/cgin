func (s *{{ .CamelName }}Service) List(ctx context.Context, filter List{{ .PascalName }}Filter) ([]sqlc.{{ .PascalName }}, response.Meta, error) {
	page := max(filter.Page, 1)
	pageSize := min(max(filter.PageSize, 1), 100)

	params := sqlc.List{{ .PluralPascal }}Params{
		PageOffset: int64((page - 1) * pageSize),
		PageLimit:  int64(pageSize),
	}
	if search := strings.TrimSpace(filter.Search); search != "" {
		pattern := "%" + search + "%"
		params.Search = &pattern
	}
	if status := strings.TrimSpace(filter.Status); status != "" {
		params.Status = &status
	}

	rows, err := s.db.Queries(ctx).List{{ .PluralPascal }}(ctx, params)
	if err != nil {
		return nil, response.Meta{}, errs.Internal(err)
	}

	total := 0
	if len(rows) > 0 {
		total = int(rows[0].TotalCount)
	}
	items := make([]sqlc.{{ .PascalName }}, len(rows))
	for i, r := range rows {
		items[i] = r.{{ .PascalName }}
	}
	return items, response.NewMeta(page, pageSize, total), nil
}

