}

type {{ .CamelName }}Service struct {
	db *database.DB
}

// NewService 构造 {{ .ChineseName }} 业务服务实例。
func New{{ .PascalName }}Service(db *database.DB) {{ .PascalName }}Service {
	return &{{ .CamelName }}Service{db: db}
}

// List 分页查询{{ .ChineseName }}，总数由 count(*) OVER () 单查询返回。
func (s *{{ .CamelName }}Service) List(ctx context.Context, query {{ .DTOPackage }}.List{{ .PascalName }}QueryParams) ([]{{ .DTOPackage }}.{{ .PascalName }}Resource, response.Meta, error) {
	page := max(query.Page, 1)
	pageSize := min(max(query.PageSize, 1), 100)

	params := sqlc.List{{ .PluralPascal }}Params{
		PageOffset: int64((page - 1) * pageSize),
		PageLimit:  int64(pageSize),
	}
	if search := strings.TrimSpace(query.Search); search != "" {
		pattern := "%" + search + "%"
		params.Search = &pattern
	}
	if status := strings.TrimSpace(query.Status); status != "" {
		params.Status = &status
	}

	rows, err := s.db.Queries(ctx).List{{ .PluralPascal }}(ctx, params)
	if err != nil {
		return nil, response.Meta{}, errs.Internal(err)
	}

	total := 0
	if len(rows) > 0 {
		total = int(rows[0].TotalCount)
	}
	items := lo.Map(rows, func(row sqlc.List{{ .PluralPascal }}Row, _ int) {{ .DTOPackage }}.{{ .PascalName }}Resource {
		return {{ .DTOPackage }}.To{{ .PascalName }}Resource(&row.{{ .PascalName }})
	})
	return items, response.NewMeta(page, pageSize, total), nil
}

// GetByID 按主键查询{{ .ChineseName }}详情。
func (s *{{ .CamelName }}Service) GetByID(ctx context.Context, id string) (*{{ .DTOPackage }}.{{ .PascalName }}Resource, error) {
	entity, err := s.db.Queries(ctx).Get{{ .PascalName }}ByID(ctx, sqlc.Get{{ .PascalName }}ByIDParams{ID: id})
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return nil, errs.NotFound("{{ .KebabName }} not found")
		}
		return nil, errs.Internal(err)
	}

	res := {{ .DTOPackage }}.To{{ .PascalName }}Resource(&entity)
	return &res, nil
}

// Create 创建{{ .ChineseName }}。
func (s *{{ .CamelName }}Service) Create(ctx context.Context, req {{ .DTOPackage }}.Create{{ .PascalName }}Body) (*{{ .DTOPackage }}.{{ .PascalName }}Resource, error) {
	entity, err := s.db.Queries(ctx).Create{{ .PascalName }}(ctx, sqlc.Create{{ .PascalName }}Params{
		Name:        strings.TrimSpace(req.Name),
		Description: &req.Description,
		Status:      req.Status,
	})
	if err != nil {
		return nil, errs.Internal(err)
	}

	res := {{ .DTOPackage }}.To{{ .PascalName }}Resource(&entity)
	return &res, nil
}

// Update 单语句局部更新{{ .ChineseName }}。
func (s *{{ .CamelName }}Service) Update(ctx context.Context, id string, req {{ .DTOPackage }}.Update{{ .PascalName }}Body) (*{{ .DTOPackage }}.{{ .PascalName }}Resource, error) {
	params := sqlc.Update{{ .PascalName }}Params{ID: id, Name: req.Name, Status: req.Status}
	if req.Description != nil {
		trimmed := strings.TrimSpace(*req.Description)
		if trimmed == "" {
			params.ClearDescription = true
		} else {
			params.Description = &trimmed
		}
	}

	entity, err := s.db.Queries(ctx).Update{{ .PascalName }}(ctx, params)
	if err != nil {
		if errors.Is(err, pgx.ErrNoRows) {
			return nil, errs.NotFound("{{ .KebabName }} not found")
		}
		return nil, errs.Internal(err)
	}

	res := {{ .DTOPackage }}.To{{ .PascalName }}Resource(&entity)
	return &res, nil
}

// Delete 软删除{{ .ChineseName }}。
func (s *{{ .CamelName }}Service) Delete(ctx context.Context, id string) error {
	affected, err := s.db.Queries(ctx).SoftDelete{{ .PascalName }}(ctx, sqlc.SoftDelete{{ .PascalName }}Params{ID: id})
	if err != nil {
		return errs.Internal(err)
	}
	if affected == 0 {
		return errs.NotFound("{{ .KebabName }} not found")
	}
	return nil
}
