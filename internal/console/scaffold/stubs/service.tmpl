// Service 定义 {{ .ChineseName }} 业务用例契约。
type {{ .PascalName }}Service interface {
	List(ctx context.Context, query {{ .DTOPackage }}.List{{ .PascalName }}QueryParams) ([]{{ .DTOPackage }}.{{ .PascalName }}Resource, response.Meta, error)
	GetByID(ctx context.Context, id string) (*{{ .DTOPackage }}.{{ .PascalName }}Resource, error)
	Create(ctx context.Context, req {{ .DTOPackage }}.Create{{ .PascalName }}Body) (*{{ .DTOPackage }}.{{ .PascalName }}Resource, error)
	Update(ctx context.Context, id string, req {{ .DTOPackage }}.Update{{ .PascalName }}Body) (*{{ .DTOPackage }}.{{ .PascalName }}Resource, error)
